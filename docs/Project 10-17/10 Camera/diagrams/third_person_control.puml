@startuml 第三人称摄像机控制流程
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #FCE4EC
skinparam activityBorderColor #C2185B
skinparam activityStartColor #00C853
skinparam activityEndColor #D32F2F
skinparam defaultFontName Microsoft YaHei

title 第三人称摄像机控制流程

start

:UpdateScene(dt);

partition "设置目标" {
    :target = WoodCrate.GetPosition();
    :Camera->SetTarget(target);
    note right
        摄像机始终跟踪木箱
    end note
}

partition "鼠标旋转控制" {
    if (右键拖拽?) then (是)
        :RotateX(MouseDelta.y * 0.01f);
        note right
            垂直旋转
            限制在[0, PI/3]
            避免翻转
        end note
        
        :RotateY(MouseDelta.x * 0.01f);
        note right
            水平旋转
            360度环绕
        end note
    endif
}

partition "距离控制" {
    if (鼠标滚轮?) then (是)
        :Approach(-MouseWheel * 1.0f);
        note right
            滚轮前滚: 拉近
            滚轮后滚: 拉远
            距离限制在[minDist, maxDist]
        end note
    endif
}

partition "更新摄像机位置" {
    :计算摄像机位置;
    note right
        position = target + 
          distance * 
          (cos(rotY) * sin(rotX),
           cos(rotX),
           sin(rotY) * sin(rotX))
    end note
    
    :LookAt(position, target, up);
}

:更新视图矩阵;
:view = Camera->GetViewXM();

stop

@enduml
